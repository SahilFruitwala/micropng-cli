{
  "name": "micropng-cli",
  "version": "0.1.0",
  "description": "High-performance CLI image compressor using sharp and libvips",
  "files": [
    "dist",
    "README.md"
  ],
  "main": "index.js",
  "type": "module",
  "bin": {
    "micropng-cli": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build",
    "build:bin": "tsup && pkg ."
  },
  "keywords": [
    "image-compression",
    "cli",
    "sharp",
    "recursive",
    "optimization"
  ],
  "author": "Sahil",
  "license": "ISC",
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.2",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.3.3",
    "p-limit": "^7.2.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.1.0",
    "@types/sharp": "^0.31.1",
    "@vitest/coverage-v8": "^4.0.18",
    "pkg": "^5.8.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
